    "hour": { "one": "小时", "other": "小时" },
    "day": { "one": "天", "other": "天" },
    "week": { "one": "周", "other": "周" },
    "month": { "one": "个月", "other": "个月" },
    "year": { "one": "年", "other": "年" }
