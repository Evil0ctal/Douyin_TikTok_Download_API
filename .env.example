# Bootstrap settings only. Everything else is seeded into the database on first
# init and edited from the console afterwards; see docs/design/10-configuration.md.
#
# Generate the secret with: openssl rand -base64 48
# The process refuses to start if it is missing or shorter than 32 characters.
DTK_SECRET_KEY=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

DTK_DATABASE_URL=postgresql+asyncpg://dtk:${POSTGRES_PASSWORD}@postgres:5432/dtk
DTK_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

DTK_BIND_HOST=127.0.0.1
DTK_BIND_PORT=8000
DTK_LOG_LEVEL=info
DTK_LOG_JSON=true

# Empty disables automatic identity minting; the pool then relies on manual
# cookie imports. Set to the browser-rpc service when running --profile browser.
DTK_BROWSER_RPC_URL=
