{
  "name": "dtk-console",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Web console for the dtk self-hosted Douyin/TikTok data API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && node scripts/check-i18n.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.2.2"
  }
}
