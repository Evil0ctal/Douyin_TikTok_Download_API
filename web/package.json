{
  "name": "dtk-console",
  "private": true,
  "version": "5.1.10",
  "type": "module",
  "description": "Web console for the dtk self-hosted Douyin/TikTok data API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && node scripts/check-i18n.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.5.11",
    "i18next-icu": "^2.6.1",
    "intl-messageformat": "^12.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
